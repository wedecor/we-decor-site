# =============================================================================
# We Decor — environment template (PLACEHOLDERS ONLY — never commit real values)
# Copy to project root as `.env.local` for local dev, or set in Vercel Dashboard.
# =============================================================================

# --- Public (browser-safe, prefixed with NEXT_PUBLIC_) ---
NEXT_PUBLIC_SITE_URL=https://www.wedecorevents.com
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_CLOUDINARY_CLOUD=your-cloudinary-cloud-name
NEXT_PUBLIC_GOOGLE_PLACE_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# --- Server-only (NEVER use NEXT_PUBLIC_ for these) ---
SENTRY_DSN=
GOOGLE_PLACES_API_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=www.wedecorevents.com
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_FROM=We Decor <leads@wedecorevents.com>
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
LEAD_IP_HASH_SALT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Dev/test only — never set in production
# CONTACT_SKIP_CAPTCHA=1

# --- Optional: local tooling only (not required for site runtime) ---
# VERCEL_OIDC_TOKEN=  # CI/Vercel CLI only — never commit
