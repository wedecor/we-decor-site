# Dependencies
node_modules/

# Next.js
.next/
out/

# Vercel
.vercel/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.sentry-build-plugin

# Safe templates live under /env
/env/.env
/env/.env.local
/env/.env.production

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test & audit artifacts (may contain leaked scan matches)
artifacts/
!artifacts/.gitkeep
public/_originals/
playwright-report/
test-results/
coverage/
*.lcov

# OS / editor
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc build outputs
dist/
build/
.cache/
tmp/
temp/
